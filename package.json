{
  "name": "stable-grid-game",
  "version": "2.0.0",
  "description": "Modern grid-based collaborative game with human-AI and human-human support",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages -f",
    "preview": "vite preview",
    "start": "node server/index.js",
    "render-build": "npm install && vite build",
    "drive:oauth": "node scripts/google-drive-oauth.js",
    "drive:check": "node scripts/google-drive-check.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.7.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "gh-pages": "^6.3.0",
    "nodemon": "^3.0.1",
    "vite": "^4.4.9"
  },
  "type": "module"
}
