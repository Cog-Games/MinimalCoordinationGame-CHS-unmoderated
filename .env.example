# Enable the self-hosted parent permission + camera flow in the Vite build.
VITE_SELF_HOSTED_STUDY_ENABLED=true
VITE_STUDY_API_BASE_URL=/api/study
VITE_STUDY_PERMISSION_VERSION=test-v1
VITE_STUDY_ASSENT_VERSION=test-v1
VITE_STUDY_VIDEO_SEGMENT_MS=30000
VITE_STUDY_VIDEO_BITRATE=900000
VITE_STUDY_RECORD_AUDIO=true
VITE_BASE_PATH=/

# Server and operational metadata database.
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Change these together if ports 3000/3001 are already occupied.
VITE_DEV_SERVER_PORT=3000
VITE_DEV_API_TARGET=http://localhost:3001
DATABASE_URL=
STUDY_VERSION=test-v1
STUDY_ADMIN_API_KEY=replace-with-a-long-random-value
STUDY_MAX_VIDEO_SEGMENT_MB=20
# Optional access code for the test study. Leave blank to allow anyone with the URL.
STUDY_TEST_ACCESS_CODE=
# Optional: joint or individual. Leave blank for server-side 50/50 assignment.
STUDY_FORCE_CONDITION=

# Parent withdrawal/deletion email. In local test mode, the completion page
# displays the link instead of sending email.
STUDY_ENABLE_DIRECT_DELETION_LINKS=false
PUBLIC_STUDY_URL=http://localhost:3001
STUDY_WITHDRAWAL_LINK_DAYS=30
STUDY_WITHDRAWAL_LINK_COOLDOWN_SECONDS=60
STUDY_EMAIL_TEST_MODE=true
STUDY_EMAIL_FROM=
STUDY_WITHDRAWAL_EMAIL_SUBJECT=Your study withdrawal and deletion link
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Local mode is useful for code tests only. Files are written under data/study-test.
STUDY_STORAGE_MODE=local
STUDY_LOCAL_STORAGE_DIR=./data/study-test

# To test with your current My Drive, set STUDY_STORAGE_MODE=google-drive and
# configure an OAuth refresh token plus the ID of a folder in your Drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Add this exact URI to the Google OAuth client when using npm run drive:oauth.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:53682/oauth2callback

# Later, for Duke Shared Drive, remove the three OAuth values above and provide
# the service-account JSON on one line. Add that service account to the Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
